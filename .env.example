# Public site URL (canonical). Keep as the production domain.
NEXT_PUBLIC_SITE_URL=https://veldriva.com

# Optional: shown in footer / Organization schema only when set.
NEXT_PUBLIC_LINKEDIN_URL=
# Optional: when set, a "Book a call" option appears on the contact page.
NEXT_PUBLIC_CALENDAR_URL=
# Optional: ATS / careers portal link used on /careers.
NEXT_PUBLIC_CAREERS_URL=
# Optional: Google Search Console HTML-tag verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- Contact form (server-side only; never prefix with NEXT_PUBLIC_) ----
# Address that receives inquiries.
CONTACT_TO_EMAIL=info@veldriva.com
# Sender address on a domain verified with your email provider (e.g. Resend).
CONTACT_FROM_EMAIL=
# Resend API key (https://resend.com). The form returns a "not configured" error without it.
RESEND_API_KEY=

# Optional bot protection: Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
